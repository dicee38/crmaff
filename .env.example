# Скопируй в .env и заполни реальными значениями. Никогда не коммить .env.

ENVIRONMENT=development

# PostgreSQL
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth / JWT
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Webhook signing secrets
BINOLLA_WEBHOOK_SECRET=change-me
CHATTERFY_WEBHOOK_SECRET=change-me
TRACK_CLICK_SIGNING_SECRET=change-me

# Sentry
SENTRY_DSN=

# CORS
CORS_ORIGINS=http://localhost:5173
